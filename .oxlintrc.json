{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-hooks",
    "nextjs",
    "vitest",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "nextjs/no-img-element": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["next-env.d.ts"]
}
